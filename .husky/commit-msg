# husky points core.hooksPath at this repository, which bypasses a developer's global hooks.
# If a global core.hooksPath is configured and has a commit-msg hook, hand over to it so that
# hook still runs. Without a global hook this does nothing. (husky runs hooks with `sh -e`, and
# `git config` exits 1 when the key is unset, hence the `|| true`.)
global_hooks=$(git config --global core.hooksPath 2>/dev/null || true)
if [ -n "$global_hooks" ] && [ -x "$global_hooks/commit-msg" ]; then
  "$global_hooks/commit-msg" "$1" || exit $?
fi
