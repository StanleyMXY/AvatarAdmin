# Copy to .env.local (ignored by git) and adjust. No secrets belong in this repository.

# Where `npm run dev:api` proxies /api to (the real backend, no mock).
ADMIN_API_PROXY_TARGET=http://127.0.0.1:8080

# Build-time variables (all optional; the defaults below are what the build uses when unset).
ADMIN_PRODUCT_NAME=Admin
# Leave empty to use the neutral logo bundled in public/logo.svg. Must be a same-origin path, never an external URL.
ADMIN_LOGO_URL=/logo.svg
ADMIN_PRIMARY_COLOR=#0ABAB5
ADMIN_PRIMARY_HOVER=#3DCBC7
ADMIN_PRIMARY_ACTIVE=#089A96
# Call-quality red-frame thresholds (fractions, 0..1).
ADMIN_QUALITY_MIN_SUCCESS_RATE=0.95
ADMIN_QUALITY_MAX_SLOW_SHARE=0.05
